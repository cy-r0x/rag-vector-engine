LOG_LEVEL=INFO

# --- Auth (JWT, HS256) ---
# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
# Access token lifetime in seconds
JWT_EXPIRES_IN=3600

# --- PostgreSQL ---
# Credentials used by docker compose (must match DATABASE_URL)
POSTGRES_USER=rve
POSTGRES_PASSWORD=rve
POSTGRES_DB=rve
# Host port; 5433 avoids clashing with a natively installed Postgres on 5432
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://rve:rve@localhost:5433/rve

# --- Upload validation ---
# Max upload size, and max total uncompressed size of DOCX/XLSX archives (zip-bomb guard)
MAX_UPLOAD_BYTES=26214400
MAX_UNCOMPRESSED_BYTES=209715200
# Per upload request: max number of files, and max total request body size
MAX_UPLOAD_FILES=50
MAX_BATCH_BYTES=209715200

# --- RabbitMQ ---
# Credentials used by docker compose (must match RABBITMQ_URL)
RABBITMQ_USER=rve
RABBITMQ_PASSWORD=rve
RABBITMQ_URL=amqp://rve:rve@localhost:5672/
# Queue the ingestion worker consumes from
INGESTION_QUEUE=ingestion.jobs
# Queue the worker publishes document status events to; the API consumes it and updates PostgreSQL
DOCUMENT_EVENTS_QUEUE=document.events
# Max unacknowledged messages per consumer
CONSUMER_PREFETCH=10
# Run the document status consumer inside the API process
CONSUME_DOCUMENT_EVENTS=true

# --- Chunking (worker) ---
# Max characters per chunk, and characters repeated from the end of the previous chunk
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings ---
# Provider implementation to use (registered in infra/embeddings/factory.py): gemini
EMBEDDING_PROVIDER=gemini
# Model name; empty = the provider's default (gemini: gemini-embedding-001)
EMBEDDING_MODEL=
# Vector size; changing it requires re-embedding every document
EMBEDDING_DIMENSIONS=768
# Texts per embedding API request (Gemini allows up to 100)
EMBEDDING_BATCH_SIZE=100
# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Chat answers (LLM) ---
# Provider implementation (registered in infra/llm/factory.py): gemini
LLM_PROVIDER=gemini
# Model name; empty = the provider's default (gemini: gemini-3.5-flash-lite)
LLM_MODEL=
LLM_TEMPERATURE=0.2

# --- Retrieval (chat) ---
# Chunks passed to the LLM per question, and the minimum cosine similarity a chunk needs
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.65
CHAT_MAX_QUERY_CHARS=2000
# Lifetime (seconds) of the one-time ticket used to open the chat WebSocket
CHAT_TICKET_EXPIRES_IN=60

# --- Qdrant (vector DB) ---
# Host port used by docker compose (must match QDRANT_URL)
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
# Empty for the local container; set for Qdrant Cloud
QDRANT_API_KEY=
# One collection for all tenants; every query is pre-filtered by business_id
QDRANT_COLLECTION=document_chunks

# --- Object storage (S3 API) ---
# Local MinIO (docker compose)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=documents
S3_FORCE_PATH_STYLE=true

# MinIO root credentials used by docker compose (must match the S3 keys above)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# AWS S3: leave the endpoint empty, use virtual-hosted style, and either set
# keys or leave them empty to use the default AWS credential chain (IAM role, profile).
# S3_ENDPOINT_URL=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=my-rag-documents
# S3_FORCE_PATH_STYLE=false
