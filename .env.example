LOG_LEVEL=INFO

# --- Auth (JWT, HS256) ---
# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
# Access token lifetime in seconds
JWT_EXPIRES_IN=3600

# --- PostgreSQL ---
# Credentials used by docker compose (must match DATABASE_URL)
POSTGRES_USER=rve
POSTGRES_PASSWORD=rve
POSTGRES_DB=rve
# Host port; 5433 avoids clashing with a natively installed Postgres on 5432
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://rve:rve@localhost:5433/rve

# --- Upload validation ---
# Max upload size, and max total uncompressed size of DOCX/XLSX archives (zip-bomb guard)
MAX_UPLOAD_BYTES=26214400
MAX_UNCOMPRESSED_BYTES=209715200

# --- RabbitMQ ---
# Credentials used by docker compose (must match RABBITMQ_URL)
RABBITMQ_USER=rve
RABBITMQ_PASSWORD=rve
RABBITMQ_URL=amqp://rve:rve@localhost:5672/
# Queue the ingestion worker consumes from
INGESTION_QUEUE=ingestion.jobs
# Max unacknowledged messages per consumer
CONSUMER_PREFETCH=10

# --- Object storage (S3 API) ---
# Local MinIO (docker compose)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=documents
S3_FORCE_PATH_STYLE=true

# MinIO root credentials used by docker compose (must match the S3 keys above)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# AWS S3: leave the endpoint empty, use virtual-hosted style, and either set
# keys or leave them empty to use the default AWS credential chain (IAM role, profile).
# S3_ENDPOINT_URL=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=my-rag-documents
# S3_FORCE_PATH_STYLE=false
